<?xml version="1.0"?>
<package format="2">
  <name>haptiquad_nav</name>
  <version>0.1.0</version>
  <description>
    HaptiQuad navigation stack — contact-based obstacle classification
    using GRF/base wrench estimation with a dual-costmap architecture.
    Includes the HaptiQuadNavPlanner nav_core plugin.
  </description>

  <maintainer email="elechim2196@gmail.com">mlisi1</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- C++ local planner plugin deps -->
  <depend>angles</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Core nav deps -->
  <depend>move_base</depend>
  <depend>nav_core</depend>
  <depend>costmap_2d</depend>
  <depend>navfn</depend>
  <depend>global_planner</depend>
  <depend>base_local_planner</depend>
  <depend>dwa_local_planner</depend>
  <depend>rotate_recovery</depend>
  <depend>clear_costmap_recovery</depend>
  <depend>map_server</depend>

  <!-- Message deps -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>

  <!-- Goal relay: ANYmal RViz publishes 2D Nav Goal to /goal, we relay it -->
  <depend>topic_tools</depend>

  <!-- Python node deps -->
  <depend>move_base_msgs</depend>
  <depend>actionlib</depend>
  <depend>tf</depend>
  <depend>haptiquad_msgs</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rostopic</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <nav_core plugin="${prefix}/haptiquad_nav_planner_plugin.xml"/>
  </export>
</package>
