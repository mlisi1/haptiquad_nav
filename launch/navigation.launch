<launch>
  <!-- ============================================================
       HaptiQuad Navigation Stack: entry point.

       Starts only what does not move the robot: the odom/wrench bridges,
       anymal_motion_init (e-stop clear + walk mode, right away) and
       nav_supervisor. nav_supervisor starts navigation_core.launch
       (move_base, contact_probe_manager, cmd_vel_gate, ...) only once every
       input in config/nav_supervisor.yaml is healthy and walk mode is
       reached, and keeps publishing /haptiquad_nav/health afterwards.
       No velocity command reaches twist_mux unless that heartbeat and
       contact_probe_manager's motion_allowed are both True.

       Two costmaps: global = only confirmed solids; local = all free.

       platform:=robot (default) loads the *_robot.yaml overlays and uses a
       rolling global costmap (no map_server); platform:=sim keeps the
       simulation configuration (pass use_sim_time:=true too).
  ============================================================ -->

  <arg name="platform"          default="robot" doc="robot | sim"/>
  <arg name="use_sim_time"      default="$(eval platform == 'sim')"/>
  <arg name="map_server"        default="$(eval platform == 'sim')"/>
  <arg name="map_file"          default="$(find haptiquad_nav)/maps/empty.yaml"/>
  <arg name="map_frame"         default="map"/>
  <arg name="pointcloud_topic"  default="/lidar/point_cloud"/>
  <arg name="wrench_topic"      default="/anymal/base_wrench"/>
  <!-- twist_mux input the gate publishes to. On the robot, check its
       twist_mux config: this input must rank below the joystick and must
       not be shared with the native path follower. -->
  <arg name="cmd_vel_topic"     default="/path_planning_and_following/twist"/>
  <!-- move_base publishes raw Twist here; cmd_vel_gate stamps and gates it -->
  <arg name="cmd_vel_raw_topic" default="/haptiquad_nav/cmd_vel_raw"/>
  <!-- set to false if robot is already in walk mode -->
  <arg name="init_robot"        default="true"/>
  <arg name="rviz"              default="false"/>
  <arg name="rviz_config"       default="$(find haptiquad_nav)/config/navigation.rviz"/>
  <!-- MOVABLE/SOLID criterion override ('force' | 'displacement'); blank =
       contact_probe.yaml. See its "Classification criterion" section. -->
  <arg name="classification_mode" default=""/>
  <!-- haptiquad_nav_eval sweeps only: enables contact_probe_manager's
       reset/override/injection hooks. Never on the robot. -->
  <arg name="eval_mode"         default="false"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <!-- Reset every launch: nav_supervisor waits for anymal_motion_init to set it. -->
  <param name="/haptiquad_nav/motion_initialized" value="false" if="$(arg init_robot)"/>

  <!-- ── Odom bridge: pose_in_odom + twist → nav_msgs/Odometry ─── -->
  <node name="odom_bridge" pkg="haptiquad_nav"
        type="odom_bridge.py" output="screen"/>

  <!-- ── Wrench bridge: EstimatedForces → WrenchStamped ────────── -->
  <node name="wrench_bridge" pkg="haptiquad_nav"
        type="wrench_bridge.py" output="screen">
    <remap from="base_wrench" to="$(arg wrench_topic)"/>
  </node>

  <!-- ── ANYmal motion initializer (estop clear + trekker walk) ── -->
  <node if="$(arg init_robot)" name="anymal_motion_init"
        pkg="haptiquad_anymal_bringup" type="init_motion.py" output="screen"/>

  <!-- ── Preflight + health monitor; starts navigation_core.launch ── -->
  <node name="nav_supervisor" pkg="haptiquad_nav" type="nav_supervisor.py"
        output="screen" required="true">
    <rosparam file="$(find haptiquad_nav)/config/nav_supervisor.yaml" command="load"/>
    <param name="wait_for_true_param" value="/haptiquad_nav/motion_initialized"
           if="$(arg init_robot)"/>
    <param name="core_args" value="platform:=$(arg platform)
                                   map_server:=$(arg map_server)
                                   map_file:=$(arg map_file)
                                   map_frame:=$(arg map_frame)
                                   pointcloud_topic:=$(arg pointcloud_topic)
                                   wrench_topic:=$(arg wrench_topic)
                                   cmd_vel_topic:=$(arg cmd_vel_topic)
                                   cmd_vel_raw_topic:=$(arg cmd_vel_raw_topic)
                                   rviz:=$(arg rviz)
                                   rviz_config:=$(arg rviz_config)
                                   classification_mode:='$(arg classification_mode)'
                                   eval_mode:=$(arg eval_mode)"/>
  </node>
</launch>
